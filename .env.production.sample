NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://your-frontend-domain.com

DB_NAME=authbase_prod
DB_HOST=your-prod-db-host
DB_PORT=3306
DB_USER=your_prod_db_user
DB_PASSWORD=your_prod_db_password

ACCESS_TOKEN_SECRET=your_prod_access_token_secret_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_prod_refresh_token_secret_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Email (SMTP via nodemailer)
MAILUSER=production-email@domain.com
MAILPASS=your_prod_email_password_or_app_password
MAIL_FROM_NAME=AuthMicroservice
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
PRODUCT_DOCS_URL=https://your-api-domain.com/docs

SESSION_SECRET=your_prod_session_secret_min_32_chars

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_prod_google_client_id
GOOGLE_CLIENT_SECRET=your_prod_google_client_secret
GOOGLE_CALLBACK_URL=https://your-api-domain.com/api/v1/auth/google/callback

# OAuth redirect URLs (optional - falls back to JSON response if not set)
OAUTH_SUCCESS_REDIRECT_URL=https://your-frontend-domain.com/auth/success
OAUTH_FAILURE_REDIRECT_URL=https://your-frontend-domain.com/auth/failed
