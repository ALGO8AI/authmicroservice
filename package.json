{
  "name": "auth-microservice",
  "version": "1.0.0",
  "description": "Authorization microservice with Node.js and MySQL",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/",
    "lint:all": "eslint src test scripts eslint.config.js jest.unit.config.js",
    "init-db": "node scripts/init-db.js",
    "create-admin": "node scripts/create-admin.js",
    "swagger": "echo \"API docs are defined in swagger.yaml — edit that file directly and restart the server\"",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.unit.config.js",
    "test:unit:impact": "node ./scripts/generate-unit-impact-map.js",
    "test:unit:report": "node ./scripts/clean-unit-reports.js && npm run test:unit:impact && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.unit.config.js --coverage --json --outputFile=./tests/reports/jest/unit-test-summary.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALGO8AI/authmicroservice.git"
  },
  "author": "Raunak Garg",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ALGO8AI/authmicroservice/issues"
  },
  "homepage": "https://github.com/ALGO8AI/authmicroservice#readme",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-compression": "^1.0.2",
    "express-rate-limit": "^7.3.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailgen": "^2.0.28",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.8",
    "sequelize": "^6.37.5",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.5",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-html-reporters": "^3.1.7",
    "nodemon": "^3.1.2",
    "prettier": "^3.8.1"
  }
}
