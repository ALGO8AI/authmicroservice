NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000

DB_NAME=authbase_dev
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_dev_db_password

ACCESS_TOKEN_SECRET=your_dev_access_token_secret_min_32_chars
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_dev_refresh_token_secret_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Email (SMTP via nodemailer)
MAILUSER=dev-email@domain.com
MAILPASS=your_dev_email_password_or_app_password
MAIL_FROM_NAME=AuthMicroservice-Dev
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
PRODUCT_DOCS_URL=http://localhost:8080/docs

SESSION_SECRET=your_dev_session_secret_min_32_chars

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_dev_google_client_id
GOOGLE_CLIENT_SECRET=your_dev_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# OAuth redirect URLs (optional - falls back to JSON response if not set)
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/success
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/auth/failed
